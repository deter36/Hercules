      "issue_id": "ISS-RS-RS-001-003",
      "disposition": {
        "type": "no_change",
        "state": "proposed_for_canon",
        "action": "Preserve the correct recorded terminal expectation; route an explicitly authorized engine correction and independent replay assertion. Do not change active_failure_terminal to active to obtain PASS."
      }
    },
    {
      "issue_id": "ISS-RS-RS-001-004",
      "disposition": {
        "type": "no_change",
        "state": "proposed_for_canon",
        "action": "Retain the existing nonretroactive rule; route an engine correction plus regression addition that actually enters Cannot Block during impacts. Existing F004/F005 test checks only roll-time snapshots, not subsequent entry."
      }
    }
